@model List<IglesiaGo.Models.Noticia>
@{
    ViewData["Title"] = "Inicio";
}

<div class="position-relative overflow-hidden text-center text-white" 
     style="background-color: #212529; min-height: 220px; display: flex; align-items: center; justify-content: center; padding: 2rem 0;">
    <div class="container">
        <h1 class="fw-bold mb-2 text-uppercase" style="letter-spacing: -1px; font-size: 2.5rem;">
            EXPERIMENTA SU PRESENCIA
        </h1>
        <p class="lead mb-3 text-uppercase opacity-75" style="letter-spacing: 2px; font-size: 13px;">
            Un lugar para conectar con Dios
        </p>
        <div>
            <a class="btn btn-outline-light px-4 py-1 fw-bold" style="border-radius: 0; font-size: 11px; letter-spacing: 1px;" asp-action="Ensenanzas">
                VER ENSEÑANZAS
            </a>
        </div>
    </div>
</div>

<div class="container my-5 py-3">
    <div class="text-center mb-5">
        <h2 class="fw-bold" style="letter-spacing: -1px;">LO ÚLTIMO EN IGLESIAGO</h2>
        <div class="mx-auto" style="width: 50px; height: 2px; background-color: #000;"></div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var noticia in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card border-0 h-100 shadow-sm" style="transition: transform 0.3s;">
                        <div class="overflow-hidden">
                            <img src="@noticia.ImagenPortada" class="card-img-top img-hover" alt="Noticia" style="height: 250px; object-fit: cover;">
                        </div>
                        <div class="card-body px-0 pt-4">
                            <p class="text-muted small mb-2">@noticia.Fecha.ToString("dd MMMM, yyyy").ToUpper()</p>
                            <h5 class="card-title fw-bold" style="font-size: 18px; line-height: 1.4;">
                                @(noticia.Cuerpo != null ? noticia.Cuerpo.Substring(0, Math.Min(noticia.Cuerpo.Length, 60)) : "")...
                            </h5>
                            <a href="#" class="btn btn-link p-0 text-dark fw-bold text-decoration-none mt-2" style="font-size: 12px;">LEER MÁS →</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">Estamos preparando nuevas novedades para ti.</p>
            </div>
        }
    </div>
</div>

<style>
    .img-hover:hover {
        transform: scale(1.05);
        transition: transform 0.5s ease;
    }
</style>