// RESPONDER A LA CONSULTA (Corrige el payload para MensajeConsulta)
async function enviarRespuestaConsulta() {
    const token = localStorage.getItem("token");
    const consultaId = parseInt(document.getElementById("modalConsultaId").value);
    const respuestaTexto = document.getElementById("modalRespuestaTexto").value.trim();

    if (!respuestaTexto) {
        Swal.fire('Atención', 'Escribe un mensaje para responder.', 'warning');
        return;
    }

    // Estrategia defensiva: Enviamos las claves para MensajeConsulta
    const payload = {
        ConsultaId: consultaId,
        TipoRemitente: "Admin",
        CuerpoMensaje: respuestaTexto
    };

    try {
        const res = await fetch('/api/ConsultasApi/Responder', {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            Swal.fire('¡Enviado!', 'Respuesta guardada y consulta marcada como atendida.', 'success');
            document.getElementById("modalRespuestaTexto").value = "";
            
            if (bootstrapMensajeModal) {
                bootstrapMensajeModal.hide();
            } else {
                const modalElem = document.getElementById('mensajeModal');
                if (modalElem) {
                    const instancia = bootstrap.Modal.getInstance(modalElem);
                    if (instancia) instancia.hide();
                }
            }
            
            cargarMensajes(); // Recargar la tabla para actualizar el estado
        } else {
            const errData = await res.json().catch(() => ({}));
            Swal.fire('Error', errData.mensaje || errData.detalle || 'Error al enviar la respuesta.', 'error');
        }
    } catch (err) {
        console.error("Error al enviar respuesta:", err);
        Swal.fire('Error', 'No se pudo conectar con el servidor.', 'error');
    }
}
    // 4. ELIMINAR CONSULTA (DELETE /api/ConsultasApi/{id})
    function eliminarMensaje(id) {
        Swal.fire({
            title: '¿Eliminar consulta?',
            text: "Se borrará la consulta y todo su historial de respuestas.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then(async (result) => {
            if (result.isConfirmed) {
                const token = localStorage.getItem("token");
                try {
                    const res = await fetch(`/api/ConsultasApi/${id}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': `Bearer ${token}` }
                    });

                    if (res.ok) {
                        Swal.fire('¡Eliminado!', 'La consulta ha sido borrada.', 'success');
                        cargarMensajes();
                    } else {
                        Swal.fire('Error', 'No se pudo eliminar la consulta.', 'error');
                    }
                } catch (err) {
                    Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                }
            }
        });
    }

    function buscarMiembro() {
        let input = document.getElementById("tablaBuscador").value.toLowerCase();
        let filas = document.querySelectorAll("#tablaMiembros tbody tr");

        filas.forEach(fila => {
            let texto = fila.innerText.toLowerCase();
            fila.style.display = texto.includes(input) ? "" : "none";
        });
    }

    // CORRECCIÓN CLAVE: Invocación directa del endpoint PATCH con Query Parameter
    function confirmarCambioEstado(id, nombre, volverActivar) {
        const titulo = volverActivar ? '¿Activar miembro?' : '¿Desactivar miembro?';
        const texto = volverActivar
            ? `Vas a dar de alta nuevamente a ${nombre} en el sistema.`
            : `Vas a dar de baja temporalmente a ${nombre}. Permanecerá en el sistema pero cambiará su estado.`;

        Swal.fire({
            title: titulo,
            text: texto,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: volverActivar ? '#198754' : '#ffc107',
            cancelButtonColor: '#6c757d',
            confirmButtonText: volverActivar ? 'Sí, activar' : 'Sí, desactivar',
            cancelButtonText: 'Cancelar'
        }).then(async (result) => {
            if (result.isConfirmed) {
                try {
                    const token = localStorage.getItem("token");

                    // PATCH directo a /api/personas/{id}/estado?activar=true (o false)
                    const response = await fetch(`/api/personas/${id}/estado?activar=${volverActivar}`, {
                        method: 'PATCH',
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json'
                        }
                    });

                    if (response.ok) {
                        Swal.fire({
                            title: '¡Estado Actualizado!',
                            text: `El miembro ${nombre} ha cambiado de estado con éxito.`,
                            icon: 'success',
                            confirmButtonText: 'Aceptar',
                            confirmButtonColor: '#0d6efd'
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        const err = await response.json();
                        Swal.fire({
                            title: 'Error',
                            text: err.mensaje || 'El servidor rechazó la actualización de estado.',
                            icon: 'error'
                        });
                    }
                } catch (error) {
                    console.error("Error al cambiar estado:", error);
                    Swal.fire({
                        title: 'Error de Conexión',
                        text: 'Hubo un problema al establecer comunicación con el servidor API.',
                        icon: 'warning'
                    });
                }
            }
        });
    }
</script>