    // SEGURIDAD FRONTEND: Control de Token
    (function () {
        const token = localStorage.getItem("token");
        if (!token) {
            window.location.href = "/Home/Login";
        }
    })();
</script>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/admin-personas.js" asp-append-version="true"></script>
<script src="~/js/admin-ensenanzas.js" asp-append-version="true"></script>
<script src="~/js/admin-mensajes.js" asp-append-version="true"></script>

<style>
    .bg-purple {
        background-color: #6f42c1;
    }

    .nav-tabs .nav-link {
        color: #666;
        border: none;
        border-bottom: 2px solid transparent;
    }

    .nav-tabs .nav-link.active {
        color: #000 !important;
        border-bottom: 2px solid #000 !important;
        background-color: transparent !important;
    }
</style>

<script>
    let bootstrapMiembroModal;
    let bootstrapMensajeModal;

    document.addEventListener("DOMContentLoaded", function () {
        const miembroElem = document.getElementById('miembroModal');
        if (miembroElem) {
            bootstrapMiembroModal = new bootstrap.Modal(miembroElem);
        }

        const mensajeElem = document.getElementById('mensajeModal');
        if (mensajeElem) {
            bootstrapMensajeModal = new bootstrap.Modal(mensajeElem);
        }

        const alertMsg = "@Html.Raw(TempData["ResultadoPersona"] ?? "")";
        if (alertMsg.length > 0) {
            Swal.fire({
                title: '¡Operación Exitosa!',
                text: alertMsg,
                icon: 'success',
                confirmButtonText: 'Perfecto',
                confirmButtonColor: '#0d6efd'
            });
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        cargarEnsenanzas();
        cargarMensajes();
    });

    function abrirModalNuevoMiembro() {
        document.getElementById("miembroModalLabel").textContent = "REGISTRAR NUEVO MIEMBRO";

        if (typeof limpiarFormulario === "function") {
            limpiarFormulario();
        } else {
            const form = document.querySelector("#miembroModal form");
            if (form) form.reset();
            const idInput = document.querySelector("#miembroModal input[name='Id']");
            if (idInput) idInput.value = "0";
        }

        if (bootstrapMiembroModal) {
            bootstrapMiembroModal.show();
        }
    }

    function abrirModalEditarMiembro(boton) {
        const personaObj = {
            Id: boton.getAttribute("data-id"),
            Nombres: boton.getAttribute("data-nombres"),
            Apellidos: boton.getAttribute("data-apellidos"),
            DocumentoIdentidad: boton.getAttribute("data-dni"),
            Telefono: boton.getAttribute("data-telefono"),
            Email: boton.getAttribute("data-email"),
            Ciudad: boton.getAttribute("data-ciudad"),
            TipoPersona: boton.getAttribute("data-tipo"),
            FechaNacimiento: boton.getAttribute("data-nacimiento"),
            Pais: boton.getAttribute("data-pais")
        };

        document.getElementById("miembroModalLabel").textContent = "MODIFICAR MIEMBRO";

        if (typeof cargarMiembroEnFormulario === "function") {
            cargarMiembroEnFormulario(personaObj);
        } else {
            console.error("La función cargarMiembroEnFormulario no está definida en tus scripts.");
        }

        if (bootstrapMiembroModal) {
            bootstrapMiembroModal.show();
        } else {
            const modalElement = document.getElementById('miembroModal');
            const instanciaModal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
            instanciaModal.show();
        }
    }

    function cargarEnsenanzas() {
        const token = localStorage.getItem("token");

        fetch('/api/EnsenanzasApi', {
            headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(res => res.ok ? res.json() : [])
        .then(data => {
            const tbody = document.getElementById("tablaEnsenanzas");
            if (!tbody) return;
            tbody.innerHTML = "";

            if (data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted">No hay enseñanzas registradas todavía.</td></tr>`;
                return;
            }

            data.forEach(e => {
                const fecha = new Date(e.fechaPublicacion || e.FechaPublicacion).toLocaleDateString();

                tbody.innerHTML += `
                <tr>
                    <td>
                        <div class="fw-bold">${e.titulo || e.Titulo}</div>
                        <small class="text-muted">${e.autor || e.Autor || 'Pastor Principal'}</small>
                    </td>
                    <td>${fecha}</td>
                    <td><span class="badge bg-secondary">${e.pasajeClave || e.PasajeClave || 'General'}</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary border-0 me-1" onclick="editarEnsenanza(${e.id || e.Id})"><i class="fa-solid fa-pen"></i></button>
                        <button class="btn btn-sm btn-outline-danger border-0" onclick="eliminarEnsenanza(${e.id || e.Id})"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
                `;
            });
        })
        .catch(err => {
            console.error("Error al obtener enseñanzas:", err);
            const tbody = document.getElementById("tablaEnsenanzas");
            if (tbody) tbody.innerHTML = `<tr><td colspan="4" class="text-center text-danger py-3">Error al conectar con la API de Enseñanzas.</td></tr>`;
        });
    }

    // 1. CARGAR CONSULTAS / MENSAJES (GET /api/ConsultasApi)
    function cargarMensajes() {
        const token = localStorage.getItem("token");

        fetch('/api/ConsultasApi', {
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        })
        .then(res => res.ok ? res.json() : [])
        .then(data => {
            const tbody = document.getElementById("tablaMensajes");
            if (!tbody) return;
            tbody.innerHTML = "";

            if (!data || data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted">Buzón de entrada vacío.</td></tr>`;
                return;
            }

            data.forEach(m => {
                const id = m.id || m.Id;
                const remitente = m.nombreRemitente || m.NombreRemitente || m.nombre || m.Nombre || 'Anónimo';
                const correo = m.correo || m.Correo || m.email || m.Email || '';
                const asunto = m.asunto || m.Asunto || 'Sin asunto';
                const fechaVal = m.fechaCreacion || m.FechaCreacion || m.fechaEnvio || m.FechaEnvio;
                const fecha = fechaVal ? new Date(fechaVal).toLocaleDateString() : '-';

                const atendido = m.atendido ?? m.Atendido ?? m.leido ?? m.Leido ?? false;

                tbody.innerHTML += `
                <tr>
                    <td>
                        <div class="fw-bold">${remitente}</div>
                        <small class="text-muted">${correo}</small>
                    </td>
                    <td>${asunto}</td>
                    <td>${fecha}</td>
                    <td>
                        <span class="badge ${atendido ? 'bg-success' : 'bg-warning text-dark'}">
                            ${atendido ? '<i class="fa-solid fa-check me-1"></i>Atendido' : '<i class="fa-solid fa-clock me-1"></i>Pendiente'}
                        </span>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary border-0 me-1" title="Ver Consulta / Responder" onclick="verMensaje(${id})">
                            <i class="fa-solid fa-envelope-open"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger border-0" title="Eliminar" onclick="eliminarMensaje(${id})">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                `;
            });
        })
        .catch(err => {
            console.error("Error al cargar consultas:", err);
            const tbody = document.getElementById("tablaMensajes");
            if (tbody) tbody.innerHTML = `<tr><td colspan="5" class="text-center text-danger py-3">Error al conectar con la API de Consultas.</td></tr>`;
        });
    }

    // 2. VER DETALLE DE LA CONSULTA
    async function verMensaje(id) {
        const token = localStorage.getItem("token");
        try {
            const res = await fetch(`/api/ConsultasApi/${id}`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });

            if (!res.ok) throw new Error("No se pudo obtener la consulta.");

            const consulta = await res.json();

            const remitente = consulta.nombreRemitente || consulta.NombreRemitente || consulta.nombre || 'Anónimo';
            const correo = consulta.correo || consulta.Correo || consulta.email || '';

            document.getElementById("modalMensajeRemitente").textContent = `${remitente} (${correo})`;
            document.getElementById("modalMensajeAsunto").textContent = consulta.asunto || consulta.Asunto || 'Sin asunto';
            document.getElementById("modalMensajeCuerpo").textContent = consulta.mensaje || consulta.Mensaje || consulta.contenido || consulta.Contenido || 'Sin contenido';

            document.getElementById("modalConsultaId").value = consulta.id || consulta.Id;

            if (bootstrapMensajeModal) {
                bootstrapMensajeModal.show();
            }
        } catch (err) {
            Swal.fire('Error', 'No se pudo abrir la consulta.', 'error');
        }
    }

    // 3. RESPONDER A LA CONSULTA (POST /api/ConsultasApi/Responder)
