<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 mt-2 gap-2">
    <h5 class="fw-bold text-secondary m-0">Mensajes de Contacto Recibidos</h5>
    
    <div class="d-flex gap-2 align-items-center">
        <!-- Buscador -->
        <div class="input-group input-group-sm" style="max-width: 280px;">
            <span class="input-group-text bg-white border-end-0">
                <i class="fa-solid fa-magnifying-glass text-muted"></i>
            </span>
            <input type="text" id="inputBuscarMensaje" class="form-control border-start-0 ps-0" placeholder="Buscar por remitente, asunto..." onkeyup="filtrarMensajes()">
        </div>

        <!-- Botón Nuevo Mensaje -->
        <button type="button" class="btn btn-sm btn-primary" onclick="abrirModalNuevoMensaje()">
            <i class="fa-solid fa-paper-plane me-1"></i>Nuevo Mensaje
        </button>
    </div>
</div>

<div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
    <table class="table table-hover align-middle">
        <thead class="table-light sticky-top">
            <tr>
                <th>Remitente</th>
                <th>Asunto</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tablaMensajes">
            <tr>
                <td colspan="5" class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>Cargando buzón...
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- MODAL OBLIGATORIO PARA DETALLE Y RESPUESTA DE MENSAJES/CONSULTAS -->
<div class="modal fade" id="mensajeModal" tabindex="-1" aria-labelledby="mensajeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="mensajeModalLabel">
                    <i class="fa-solid fa-envelope me-2"></i>Consulta de Contacto
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                
                <!-- Datos del Remitente y Asunto -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Remitente:</span>
                            <span class="fw-bold text-primary" id="modalMensajeRemitente">---</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Asunto:</span>
                            <span class="fw-bold text-dark" id="modalMensajeAsunto">---</span>
                        </div>
                    </div>
                </div>

                <!-- Contenido del mensaje enviado -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-bold text-secondary small">
                        Mensaje recibido:
                    </div>
                    <div class="card-body text-secondary" id="modalMensajeCuerpo" style="white-space: pre-line;">
                        Sin contenido.
                    </div>
                </div>

                <!-- Formulario de Respuesta para el Administrador -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <input type="hidden" id="modalConsultaId" value="0" />
                        
                        <label for="modalRespuestaTexto" class="form-label fw-bold text-dark small">
                            <i class="fa-solid fa-reply me-1"></i>Escribir Respuesta:
                        </label>
                        <textarea class="form-control mb-3" id="modalRespuestaTexto" rows="3" placeholder="Escribe tu respuesta para el remitente..."></textarea>
                        
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cerrar</button>
                            <button type="button" class="btn btn-primary" onclick="enviarRespuestaConsulta()">
                                <i class="fa-solid fa-paper-plane me-1"></i>Enviar Respuesta
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- MODAL NUEVO MENSAJE -->
<div class="modal fade" id="modalNuevoMensaje" tabindex="-1" aria-labelledby="modalNuevoMensajeLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalNuevoMensajeLabel">
                    <i class="fa-solid fa-paper-plane me-2"></i>Enviar Nuevo Mensaje
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formNuevoMensaje">
                    <div class="mb-3">
                        <label for="nuevoDestinatario" class="form-label fw-bold small">Destinatario (Email):</label>
                        <input type="email" class="form-control" id="nuevoDestinatario" placeholder="ejemplo@correo.com" required>
                    </div>
                    <div class="mb-3">
                        <label for="nuevoAsunto" class="form-label fw-bold small">Asunto:</label>
                        <input type="text" class="form-control" id="nuevoAsunto" placeholder="Ingrese el asunto" required>
                    </div>
                    <div class="mb-3">
                        <label for="nuevoContenido" class="form-label fw-bold small">Mensaje:</label>
                        <textarea class="form-control" id="nuevoContenido" rows="4" placeholder="Escriba el contenido del mensaje..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarEnviarNuevoMensaje()">
                    <i class="fa-solid fa-paper-plane me-1"></i>Enviar
                </button>
            </div>
        </div>
    </div>
</div>