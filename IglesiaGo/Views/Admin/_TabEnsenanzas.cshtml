<div class="d-flex justify-content-between align-items-center mb-3 mt-2">
    <h5 class="fw-bold text-secondary m-0">
        Gestión de Enseñanzas / Bosquejos
    </h5>

    <button type="button"
            class="btn btn-dark btn-sm fw-bold"
            onclick="crearNuevaEnsenanza()">
        <i class="fa-solid fa-plus me-1"></i>
        NUEVA ENSEÑANZA
    </button>
</div>

<div class="table-responsive" style="max-height:520px;overflow-y:auto;">
    <table class="table table-hover align-middle">
        <thead class="table-light sticky-top">
            <tr>
                <th>Título</th>
                <th>Fecha</th>
                <th>Link video</th>
                <th width="170" class="text-end">Acciones</th>
            </tr>
        </thead>

        <tbody id="tablaEnsenanzas">
            <tr>
                <td colspan="4" class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm me-2"></div>
                    Cargando enseñanzas...
                </td>
            </tr>
        </tbody>

    </table>
</div>

<!-- ======================= MODAL ======================= -->

<div class="modal fade" id="modalEnsenanza" tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header bg-dark text-white">

                <h5 class="modal-title" id="tituloModalEnsenanza">
                    Nueva Enseñanza
                </h5>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="formEnsenanza">

                    <input type="hidden" id="Id">

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Título
                        </label>

                        <input
                            id="Titulo"
                            class="form-control"
                            required>

                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <label class="form-label fw-bold">
                                Pasaje Clave
                            </label>

                            <input
                                id="PasajeClave"
                                class="form-control"
                                placeholder="Juan 3:16">

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-bold">
                                Fecha
                            </label>

                            <input
                                id="FechaPublicacion"
                                type="date"
                                class="form-control">

                        </div>

                    </div>

                    <div class="mt-3">

                        <label class="form-label fw-bold">
                            Contenido
                        </label>

                        <textarea
                            id="Contenido"
                            rows="15"
                            class="form-control"></textarea>

                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button
                    class="btn btn-success"
                    onclick="guardarEnsenanza()">

                    <i class="fa-solid fa-floppy-disk me-1"></i>

                    Guardar

                </button>

            </div>

        </div>

    </div>

</div>